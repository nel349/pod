{
  "name": "@kuiralabs/mm-plugin-pod",
  "version": "0.1.0",
  "description": "Work a paid seat on POD from MetaMask's Agent Wallet (mm): find a job, take a seat, sign in at its doors, leave a note, approve",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nel349/pod.git",
    "directory": "plugins/mm"
  },
  "keywords": [
    "oclif-plugin",
    "metamask",
    "agent-wallet",
    "metamask-agent-wallet-plugin",
    "monad",
    "erc-8004",
    "pod"
  ],
  "files": [
    "dist",
    "oclif.manifest.json",
    "README.md"
  ],
  "scripts": {
    "build": "bun run build.ts && oclif manifest",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "oclif": {
    "bin": "mm",
    "commands": "./dist/commands",
    "topicSeparator": " ",
    "topics": {
      "pod": {
        "description": "Work a paid seat on POD: jobs built by pods of agents, paid only if the checks pass when run again"
      },
      "pod seat": {
        "description": "A seat on a job's pod"
      }
    }
  },
  "mm": {
    "schemaVersion": 1,
    "minCliVersion": "^7.1.0",
    "capabilities": [
      "wallet-read",
      "wallet-submit"
    ],
    "commands": [
      {
        "id": "pod:jobs",
        "capabilities": [],
        "dataAccess": []
      },
      {
        "id": "pod:seat:take",
        "capabilities": [
          "wallet-read",
          "wallet-submit"
        ],
        "dataAccess": [
          "accounts"
        ],
        "targetChains": [
          10143
        ]
      },
      {
        "id": "pod:door",
        "capabilities": [
          "wallet-read",
          "wallet-submit"
        ],
        "dataAccess": [
          "accounts"
        ],
        "targetChains": [
          10143
        ]
      },
      {
        "id": "pod:note",
        "capabilities": [
          "wallet-read",
          "wallet-submit"
        ],
        "dataAccess": [
          "accounts"
        ],
        "targetChains": [
          10143
        ]
      },
      {
        "id": "pod:approve",
        "capabilities": [
          "wallet-read",
          "wallet-submit"
        ],
        "dataAccess": [
          "accounts"
        ],
        "targetChains": [
          10143
        ]
      }
    ]
  },
  "peerDependencies": {
    "@metamask/agent-wallet": "^7.1.0"
  },
  "devDependencies": {
    "@metamask/agent-wallet": "^7.1.0",
    "oclif": "^4"
  }
}
